#|Aca guardaremos nuestra credenciales de la base de datos y otras variables de entorno

# Seguridad: en producción use DEBUG=False y una SECRET_KEY propia (obligatoria si DEBUG=False)
SECRET_KEY=cambie-esta-clave-secreta
DEBUG=True
# Dominios permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL local (sin DB_NAME se usa SQLite)
DB_NAME=proyecto_alpha
DB_USER=usuario_bd
DB_PASSWORD=password de la base de datos
DB_HOST=ip del servidor host
DB_PORT=puerto base de datos
